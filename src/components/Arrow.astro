---
interface Props { direction?: 'up-right' | 'down' | 'up'; class?: string; }
const { direction = 'up-right', class: className = '' } = Astro.props;
const rotation = { 'up-right': -45, down: 90, up: -90 }[direction];
---
<svg class={`arrow-icon ${className}`} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><g transform={`rotate(${rotation} 12 12)`}><path d="M4 12h15M13 5l7 7-7 7" /></g></svg>
