---
import { typography } from '../utils/typography';
interface Screen { src: string; alt: string; caption: string; }
interface Theme { title: string; description: string; screens: Screen[]; }
interface Props { themes: Theme[]; }
const { themes } = Astro.props;
---
{themes.length > 0 && <section id="platform" class="platform-screens wrap" aria-labelledby="platform-screens-title">
  <div class="screens-heading"><h2 id="platform-screens-title"><img class="screens-brand-mark" src="/images/hackermatrix.svg" alt="" width="350" height="270" loading="lazy" /><span>Внутри <em>HackerMatrix</em></span></h2></div>
  {themes.map((theme, themeIndex) => <article class="screen-theme" aria-labelledby={`screen-theme-${themeIndex}`}>
    <div class="screen-theme-intro"><h3 id={`screen-theme-${themeIndex}`}>{typography(theme.title)}</h3><p>{typography(theme.description)}</p></div>
    <div class="screen-viewer">
      <button class="screen-stage" type="button" aria-label="Увеличить скриншот" aria-haspopup="dialog"><img src={theme.screens[0].src} alt={theme.screens[0].alt} width="1280" height="850" loading="lazy" decoding="async" /><span class="screen-zoom" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg></span></button>
      {theme.screens.length > 1 ? <div class="screen-controls" role="group" aria-label={`Экраны: ${theme.title}`}>{theme.screens.map((screen,index) => <button type="button" class="screen-choice" aria-pressed={index === 0 ? 'true' : 'false'} data-src={screen.src} data-alt={screen.alt}>{typography(screen.caption)}</button>)}</div> : <p class="screen-caption">{typography(theme.screens[0].caption)}</p>}
      <p class="screen-hint">Нажмите на скриншот, чтобы рассмотреть интерфейс.</p>
      <dialog class="screen-dialog" aria-label={`Скриншот: ${theme.title}`}><button class="screen-close" type="button" aria-label="Закрыть скриншот"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg></button><img src={theme.screens[0].src} alt={theme.screens[0].alt} width="1280" height="850" /></dialog>
    </div>
  </article>)}
</section>}
<script>
  document.querySelectorAll<HTMLElement>('.screen-viewer').forEach(viewer => {
    const image = viewer.querySelector<HTMLImageElement>('.screen-stage img');
    const dialog = viewer.querySelector<HTMLDialogElement>('.screen-dialog');
    const enlarged = dialog?.querySelector<HTMLImageElement>('img');
    viewer.querySelectorAll<HTMLButtonElement>('.screen-choice').forEach(button => {
      button.addEventListener('click', () => {
        if (!image || !button.dataset.src) return;
        image.src = button.dataset.src; image.alt = button.dataset.alt ?? '';
        if (enlarged) { enlarged.src = image.src; enlarged.alt = image.alt; }
        viewer.querySelectorAll('.screen-choice').forEach(choice => choice.setAttribute('aria-pressed', String(choice === button)));
      });
    });
    viewer.querySelector('.screen-stage')?.addEventListener('click', () => { dialog?.showModal(); document.documentElement.classList.add('screenshot-open'); });
    dialog?.querySelector('.screen-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog?.addEventListener('close', () => document.documentElement.classList.remove('screenshot-open'));
  });
</script>
